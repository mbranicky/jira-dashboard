{
  "id": "paseo-jira-sprint-workspace",
  "name": "Jira Sprint Workspace",
  "description": "Your assigned sprint issues in a native Paseo board.",
  "requirements": {
    "paseo": ">=0.14.0 <0.16.0"
  },
  "icon": "assets/icon.png",
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts"
    ],
    [
      "node",
      "scripts/prepare-native.mjs"
    ]
  ],
  "media": [
    "assets/dashboard.png",
    "assets/details.png",
    "assets/mobile.png",
    "assets/settings.png",
    "assets/appearance.png"
  ]
}
