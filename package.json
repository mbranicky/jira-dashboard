{
  "name": "paseo-jira-sprint-workspace",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "prototype": "node prototype/connect.mjs",
    "test": "node --import tsx --test prototype/*.test.mjs tests/*.test.ts",
    "rest": "node prototype/rest.mjs",
    "typecheck": "tsc --noEmit",
    "audit:secrets": "node scripts/secret-audit.mjs",
    "test:ui": "cypress run --component --browser chrome",
    "test:ui:open": "cypress open --component",
    "typecheck:ui": "tsc --noEmit -p cypress/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run typecheck:ui && npm test && npm run audit:secrets && npm run check:package",
    "audit:history": "node scripts/scan-secrets.mjs",
    "prepare:native": "node scripts/prepare-native.mjs",
    "postinstall": "npm run prepare:native",
    "pretypecheck": "npm run prepare:native",
    "pretest": "npm run prepare:native"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@getpaseo/client": "0.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "parse5": "8.1.0"
  },
  "files": [
    "npm-shrinkwrap.json",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "CHANGELOG.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "docs/",
    "SPECIFICATION.md",
    "DESIGN.md",
    "assets/icon.png",
    "assets/dashboard.png",
    "assets/details.png",
    "assets/settings.png",
    "assets/mobile.png",
    "scripts/prepare-native.mjs",
    "!server/mcp-native-location.json",
    "assets/appearance.png"
  ],
  "devDependencies": {
    "@cypress/vite-dev-server": "^8.0.0",
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.1.0",
    "cypress": "^16.2.0",
    "cypress-real-events": "^1.15.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.67.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbranicky/jira-dashboard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
