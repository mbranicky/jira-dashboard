{
  "name": "paseo-jira-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prototype": "node prototype/connect.mjs",
    "test": "node --import tsx --test prototype/*.test.mjs tests/*.test.ts",
    "rest": "node prototype/rest.mjs",
    "typecheck": "tsc --noEmit",
    "audit:secrets": "node scripts/secret-audit.mjs",
    "test:ui": "cypress run --component --browser chrome",
    "test:ui:open": "cypress open --component",
    "typecheck:ui": "tsc --noEmit -p cypress/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run typecheck:ui && npm test && npm run audit:secrets && npm run check:package"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@getpaseo/client": "0.14.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "README.md",
    "docs/",
    "SPECIFICATION.md",
    "DESIGN.md"
  ],
  "devDependencies": {
    "@cypress/vite-dev-server": "^8.0.0",
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.1.0",
    "cypress": "^16.2.0",
    "cypress-real-events": "^1.15.1",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbranicky/jira-dashboard.git"
  }
}
